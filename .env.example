# WordPress
WP_API_BASE=https://www.dmagazine.com/wp-json/wp/v2
WP_USER_AGENT=SEO DMAG Crawl

# GA4
GA4_PROPERTY_ID=320675632
GA4_KEY_FILE=./credentials/ga4-service-account.json

# Marfeel
MARFEEL_EMAIL=webmaster@dmagazine.com
MARFEEL_PASSWORD=
MARFEEL_API_BASE=https://api.newsroom.bi/api
MARFEEL_AUTH_ENDPOINT=https://api.newsroom.bi/api/user/signin

# Anthropic
ANTHROPIC_API_KEY=

# Dashboard Auth
DASHBOARD_USER=admin
DASHBOARD_PASS=

# True Value Weights (configurable)
TV_WEIGHT_AD_REVENUE=1
TV_WEIGHT_SUBSCRIPTION=50
TV_WEIGHT_SIGNUP=5
TV_WEIGHT_LOYAL_INMARKET_PV=0.10
TV_WEIGHT_ENGAGEMENT=0.001

# Server
PORT=3001
NODE_ENV=development

# --- Self-service sign-up (email verification) ---
# Sign-ups need outbound email. Without SMTP_* + APP_BASE_URL, sign-up is
# disabled in production (in dev the link is printed to the server console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="D Magazine Content Intelligence <no-reply@example.com>"
# Public URL of this site — used to build the link in the email.
APP_BASE_URL=https://your-app.onrender.com
# Comma-separated email domains allowed to sign up (default: dmagazine.com; "*" = anyone).
SIGNUP_ALLOWED_DOMAINS=dmagazine.com
# Comma-separated emails that become admins when they sign up (default: ricky.ferrer@dmagazine.com).
ADMIN_EMAILS=ricky.ferrer@dmagazine.com
