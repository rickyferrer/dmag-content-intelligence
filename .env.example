# WordPress
WP_API_BASE=https://www.dmagazine.com/wp-json/wp/v2
WP_USER_AGENT=SEO DMAG Crawl

# GA4
GA4_PROPERTY_ID=320675632
GA4_KEY_FILE=./credentials/ga4-service-account.json

# Marfeel
MARFEEL_EMAIL=webmaster@dmagazine.com
MARFEEL_PASSWORD=
MARFEEL_API_BASE=https://api.newsroom.bi/api
MARFEEL_AUTH_ENDPOINT=https://api.newsroom.bi/api/user/signin

# Cloudflare Stream (minutes viewed per video) — token needs Account > Stream:Read
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Coverage Gaps report (Monday-morning comparison of the Monday.com agenda against
# competitors). Token = a personal API token from monday.com → profile picture →
# Developers → My access tokens, from someone who can see the board. Read-only use;
# nothing is ever written back to Monday. Without it the report is skipped.
MONDAY_API_TOKEN=
# MONDAY_BOARD_ID=9655252442        # optional override (default: the DMagazine.com board)
# COVERAGE_MODEL=claude-sonnet-5    # optional override of the model that writes the report

# Anthropic
ANTHROPIC_API_KEY=

# Dashboard Auth
DASHBOARD_USER=admin
DASHBOARD_PASS=

# True Value Weights (configurable)
TV_WEIGHT_AD_REVENUE=1
TV_WEIGHT_SUBSCRIPTION=50
TV_WEIGHT_SIGNUP=5
TV_WEIGHT_LOYAL_INMARKET_PV=0.10
TV_WEIGHT_ENGAGEMENT=0.001

# Server
PORT=3001
NODE_ENV=development

# Read-only dashboard client (scripts/dash.mjs) — a dedicated non-admin account
DASH_URL=https://ci.dmagazine.com
DASH_USER=
DASH_PASS=
